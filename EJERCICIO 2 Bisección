import numpy as np  # Importamos numpy para realizar cálculos numéricos
import matplotlib.pyplot as plt  # Importamos matplotlib para la visualización de gráficos

# Definir la función a la que queremos encontrar la raíz
def f(x):
    return np.exp(-x) - x  # Función f(x) = e^(-x) - x

# Algoritmo del Método de Bisección
def biseccion(a, b, tol=1e-5, max_iter=100):
    # Verificamos si el método es aplicable en el intervalo dado
    if f(a) * f(b) >= 0:  # Debe haber un cambio de signo en f(a) y f(b)
        print("El método de bisección no es aplicable en el intervalo dado.")
        return None

    # Listas para almacenar datos de cada iteración
    iteraciones = []
    errores_abs = []  # Lista de errores absolutos
    errores_rel = []  # Lista de errores relativos
    errores_cuad = []  # Lista de errores cuadráticos
    c_old = a  # Inicializamos c_old con a para calcular errores

    # Imprimimos el encabezado de la tabla de iteraciones
    print("\nIteraciones del Método de Bisección:")
    print("Iter |       a       |       b       |       c       |      f(c)      |     Error Abs     |     Error Rel     |    Error Cuad     ")
    print("-" * 120)

    # Bucle principal de iteración
    for i in range(max_iter):
        c = (a + b) / 2  # Calculamos el punto medio del intervalo
        iteraciones.append(c)  # Guardamos la iteración actual

        # Cálculo de errores
        error_abs = abs(c - c_old)  # Error absoluto
        error_rel = abs((c - c_old) / c) if c != 0 else 0  # Error relativo (evitamos división por 0)
        error_cuad = error_abs**2  # Error cuadrático
        errores_abs.append(error_abs)
        errores_rel.append(error_rel)
        errores_cuad.append(error_cuad)

        # Imprimimos los valores en la tabla
        print(f"{i+1:4d} | {a:.8f} | {b:.8f} | {c:.8f} | {f(c):.8f} | {error_abs:.8e} | {error_rel:.8e} | {error_cuad:.8e}")

        # Criterio de parada: si f(c) es cercano a 0 o el error absoluto es menor que la tolerancia
        if abs(f(c)) < tol or error_abs < tol:
            break

        # Elegimos el nuevo intervalo para la siguiente iteración
        if f(a) * f(c) < 0:
            b = c  # La raíz está en [a, c]
        else:
            a = c  # La raíz está en [c, b]

        c_old = c  # Actualizamos c_old para la siguiente iteración

    return iteraciones, errores_abs, errores_rel, errores_cuad  # Retornamos los datos obtenidos

# Parámetros iniciales del intervalo donde buscamos la raíz
a, b = 0, 1
iteraciones, errores_abs, errores_rel, errores_cuad = biseccion(a, b)

# Graficamos la función y la convergencia del método de bisección
x = np.linspace(a - 1, b + 1, 400)  # Definimos un rango de valores para graficar
y = f(x)  # Evaluamos la función en estos puntos
fig, ax1 = plt.subplots(figsize=(8, 6))  # Creamos la figura
ax1.plot(x, y, label=r'$f(x) = e^{-x} - x$', color='b')  # Graficamos la función
ax1.axhline(0, color='k', linestyle='--', linewidth=1)  # Línea horizontal en y=0
ax1.scatter(iteraciones, [f(c) for c in iteraciones], color='red', label='Iteraciones')  # Puntos de iteración
ax1.set_xlabel('x')  # Etiqueta del eje x
ax1.set_ylabel('f(x)')  # Etiqueta del eje y
ax1.set_title("Convergencia del Método de Bisección")  # Título del gráfico
ax1.legend()  # Mostramos la leyenda
ax1.grid()  # Mostramos la cuadrícula
plt.savefig("convergencia_biseccion.png", dpi=300)  # Guardamos la imagen
plt.show()  # Mostramos la gráfica

# Graficamos los errores absoluto, relativo y cuadrático
fig, ax2 = plt.subplots(figsize=(8, 6))
ax2.plot(range(1, len(errores_abs)+1), errores_abs, marker='o', linestyle='-', color='r', label="Error Absoluto")
ax2.plot(range(1, len(errores_rel)+1), errores_rel, marker='s', linestyle='-', color='g', label="Error Relativo")
ax2.plot(range(1, len(errores_cuad)+1), errores_cuad, marker='^', linestyle='-', color='b', label="Error Cuadrático")
ax2.set_yscale("log")  # Usamos escala logarítmica para visualizar mejor los errores
ax2.set_xlabel("Iteración")  # Etiqueta del eje x
ax2.set_ylabel("Error")  # Etiqueta del eje y
ax2.set_title("Errores Absoluto, Relativo y Cuadrático en cada Iteración")  # Título de la gráfica
ax2.legend()  # Mostramos la leyenda
ax2.grid()  # Mostramos la cuadrícula
plt.savefig("errores_biseccion.png", dpi=300)  # Guardamos la imagen
plt.show()  # Mostramos la gráfica
